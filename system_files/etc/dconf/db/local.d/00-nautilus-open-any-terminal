# nautilus-open-any-terminal defaults to the terminal this image ships.
#
# The extension hardcodes terminal = "gnome-terminal"
# (nautilus_open_any_terminal.py:153) and never probes whether that binary
# exists, so "Open in Terminal" dies with
#   FileNotFoundError: [Errno 2] No such file or directory: 'gnome-terminal'
# on any image without GNOME Terminal. This one ships kitty instead.
#
# This is a dconf system default rather than a skeleton file on purpose:
# GLib's default settings backend is dconf, which does not read a keyfile at
# .config/glib-2.0/settings, so a file under /etc/skel would be silently
# ignored. A system default also reaches accounts that already exist, which
# a skeleton file could not.
#
# The schema has to be compiled before this value means anything, and a .d
# file here is only a source for `dconf update` to compile into the binary
# database, so build.sh still runs that.
[com/github/stunkymonkey/nautilus-open-any-terminal]
terminal='kitty'
