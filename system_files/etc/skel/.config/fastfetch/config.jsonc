{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/rakuos.png",
    "width": 30,
    "height": 17,
    "padding": {
      "top": 7,
      "right": 4,
      "left": 3
    },
    "color": {
      "1": "#eddd63",
      "2": "#eddd63"
    }
  },
  "display": {
    "color": {
      "keys": "#eddd8e",
      "title": "#eddd8e"
    },
    "key": {
      "width": 12
    },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "#f7e99e",
        "yellow": "#edde91",
        "red": "#e56c6c"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[1;38;2;243;237;225m{user-name}\u001b[0m\u001b[38;2;143;135;112m @ \u001b[0m\u001b[1;38;2;243;237;225m{host-name}\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh brand"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh DEVICE"
    },
    {
      "type": "host",
      "key": "{#italic_36}󰇅 {#keys} HOST"
    },
    {
      "type": "cpu",
      "key": "{#italic_36}󰍛 {#keys} CPU"
    },
    {
      "type": "gpu",
      "key": "{#italic_36}󰾲 {#keys} GPU",
      "detectionMethod": "pci",
      "format": "{vendor} {name}"
    },
    {
      "type": "display",
      "key": "{#italic_36}󰍹 {#keys} DISPLAY"
    },
    {
      "type": "memory",
      "key": "{#italic_36}󰟶 {#keys} MEMORY"
    },
    {
      "type": "swap",
      "key": "{#italic_36}󰣁 {#keys} SWAP"
    },
    {
      "type": "disk",
      "key": "{#italic_36}󰋊 {#keys} DISK"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh SYSTEM"
    },
    {
      "type": "command",
      "key": "{#italic_36} {#keys} OS",
      "text": ". /etc/os-release && echo \"$PRETTY_NAME x86_64\""
    },
    {
      "type": "kernel",
      "key": "{#italic_36} {#keys} KERNEL"
    },
    {
      "type": "command",
      "key": "{#italic_36} {#keys} WM",
      "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\""
    },
    {
      "type": "command",
      "key": "{#italic_36}󰉼 {#keys} DESKTOP",
      "text": "echo \"Noctalia $(rpm -q --qf '%{VERSION}' noctalia-git 2>/dev/null || echo unknown)\""
    },
    {
      "type": "terminal",
      "key": "{#italic_36} {#keys} TERM"
    },
    {
      "type": "command",
      "key": "{#italic_36}󰞷 {#keys} SHELL",
      "text": "basename \"${SHELL:-unknown}\""
    },
    {
      "type": "command",
      "key": "{#italic_36}󰛖 {#keys} FONT",
      "text": "c=~/.config/ghostty/config; f=$(awk -F= '/^font-family/ {g=$2; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",g); print g; exit}' \"$c\" 2>/dev/null); s=$(awk -F= '/^font-size/ {g=$2; gsub(/[[:space:]]/,\"\",g); print g; exit}' \"$c\" 2>/dev/null); [ -n \"$f\" ] && echo \"$f - $s pt\" || echo \"default - $s pt\""
    },
    {
      "type": "packages",
      "key": "{#italic_36}󰏖 {#keys} PKGS"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh SESSION"
    },
    {
      "type": "command",
      "key": "{#italic_36}󱦟 {#keys} AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %Y /var/lib/rakuos/install-id)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "{#italic_36}󰥔 {#keys} UPTIME"
    },
    "break"
  ]
}
